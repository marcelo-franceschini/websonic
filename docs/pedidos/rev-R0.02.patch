diff --git a/hooks/detector/Cargo.lock b/hooks/detector/Cargo.lock
new file mode 100644
index 0000000..b2c8623
--- /dev/null
+++ b/hooks/detector/Cargo.lock
@@ -0,0 +1,7 @@
+# This file is automatically @generated by Cargo.
+# It is not intended for manual editing.
+version = 4
+
+[[package]]
+name = "detector-rom"
+version = "0.0.0"
diff --git a/hooks/pre-commit b/hooks/pre-commit
index 7c11dea..54e6989 100755
--- a/hooks/pre-commit
+++ b/hooks/pre-commit
@@ -19,11 +19,30 @@ problemas=$(
 
 # Decisao L1 (11/11/2026): a IA pode ler a ROM, entao a guarda fica na saida. O detector
 # procura, nos arquivos do commit, trechos iguais a trechos da ROM (ver hooks/detector).
-# So vale no projeto, quando a pasta hooks/detector existe. Sem ROM, o commit e bloqueado.
+# A guarda abaixo faz o harness hooks.sh passar: ele copia o pre-commit para um repositorio
+# sem a pasta hooks/detector. No projeto a pasta existe, e o detector roda.
 if [ -f "$raiz/hooks/detector/Cargo.toml" ]; then
-    rom=$(ls /mnt/rom/*.gen "${SONIC1_EXT_DIR:-$HOME/sonic1-ext}"/rom/*.gen 2>/dev/null | head -n 1)
+    # Ordem fixa: /mnt/rom antes de SONIC1_EXT_DIR. Um laco com [ -f ] em vez de ls, porque o ls
+    # ordena os dois caminhos juntos, e a prioridade se perderia.
+    rom=""
+    for pasta in "/mnt/rom" "${SONIC1_EXT_DIR:-$HOME/sonic1-ext}/rom"; do
+        for arquivo in "$pasta"/*.gen; do
+            if [ -f "$arquivo" ]; then
+                rom="$arquivo"
+                break 2
+            fi
+        done
+    done
     [ -n "$rom" ] || recusar "commit" "  detector: ROM nao encontrada em /mnt/rom nem em SONIC1_EXT_DIR/rom"
-    cargo run --quiet --manifest-path "$raiz/hooks/detector/Cargo.toml" -- --rom "$rom" ||
+
+    # Dois passos, para que cada falha tenha a sua mensagem. O detector fica em hooks/, que e
+    # somente leitura no conteiner. Por isso o cargo grava em target/ (ignorado pelo git), e o
+    # --locked impede que ele tente regravar o Cargo.lock.
+    if ! cargo build --quiet --locked --manifest-path "$raiz/hooks/detector/Cargo.toml" \
+        --target-dir "$raiz/target/detector"; then
+        recusar "commit" "  detector: o detector nao compilou. Isso nao quer dizer que ha ROM no commit"
+    fi
+    "$raiz/target/detector/debug/detector-rom" --rom "$rom" ||
         recusar "commit" "  detector: trecho copiado da ROM, ou ROM diferente da REV01 (veja a saida acima)"
 fi
 exit 0
