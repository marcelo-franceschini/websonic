+    fn mais_de_um_bloco() {
+        // Um milhão de 'a' (vetor do padrão).
+        let v = vec![b'a'; 1_000_000];
+        assert_eq!(
+            hex(&sha256(&v)),
+            "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"
+        );
+    }
