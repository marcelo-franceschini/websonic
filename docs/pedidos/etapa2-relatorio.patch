+        let f = oraculo_falso(None, true, &chamadas);
+        let e = um_caso(&f, "rom", "rotulos", &d, &caso_demo(25), 10, true).unwrap_err();
+        assert!(e.contains("duas execuções diferem"), "{e}");
+        assert!(!nomes_na_pasta(&d).iter().any(|n| n.ends_with(".s1t")));
