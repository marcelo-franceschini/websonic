+        assert_eq!(arquivos_iguais(&d.join("a"), &d.join("b")), Ok(false));
+        fs::write(d.join("b"), &grande[..grande.len() - 1]).unwrap();
+        assert_eq!(arquivos_iguais(&d.join("a"), &d.join("b")), Ok(false));
