+/// Cadeias hexadecimais coladas, como `4e714e75...`, com pelo menos `HEX_COLADO_MIN` dígitos. Vale
+/// o maior prefixo de tamanho par, porque cada byte usa dois dígitos.
+fn hex_colado(texto: &[u8]) -> Vec<(usize, Vec<u8>)> {
+    let mut saida = Vec::new();
+    let mut i = 0;
+    while i < texto.len() {
+        let inicio = i;
+        while i < texto.len() && digito_hex(texto[i]).is_some() {
+            i += 1;
+        }
+        // Maior prefixo de tamanho par. O `as_chunks` abaixo também descartaria o dígito que sobra,
+        // mas o `& !1` deixa a regra à vista.
+        let usados = (i - inicio) & !1;
+        if usados >= HEX_COLADO_MIN {
+            let bytes: Vec<u8> = texto[inicio..inicio + usados]
+                .as_chunks::<2>()
+                .0
+                .iter()
+                .filter_map(|&[alto, baixo]| byte_hex(alto, baixo))
+                .collect();
+            saida.push((inicio, bytes));
+        }
+        // O caractere que parou a corrida não é dígito: pula ele.
+        i += 1;
+    }
+    saida
+}
