+/// Byte formado por dois dígitos hexadecimais.
+fn byte_hex(alto: u8, baixo: u8) -> Option<u8> {
+    Some((digito_hex(alto)? << 4) | digito_hex(baixo)?)
+}
+
+/// Par hexadecimal em `i`, com fronteira não alfanumérica antes e depois. A fronteira evita ler
+/// pedaços de palavras e de números: `0x4E`, `g4E` e `4E7` não são pares.
+fn par_hex_em(texto: &[u8], i: usize) -> Option<u8> {
+    let antes = i > 0 && texto.get(i - 1).is_some_and(u8::is_ascii_alphanumeric);
+    let depois = texto.get(i + 2).is_some_and(u8::is_ascii_alphanumeric);
+    if antes || depois {
+        return None;
+    }
+    byte_hex(*texto.get(i)?, *texto.get(i + 1)?)
+}
+
+/// Corridas de pares hexadecimais, como `4E 71 4E 75` ou `4e:71:4e:75`. Entre dois pares há espaço,
+/// tabulação, vírgula, dois-pontos ou quebra de linha. Devolve o deslocamento e os bytes de cada
+/// corrida com pelo menos `JANELA` pares.
+fn pares_hex(texto: &[u8]) -> Vec<(usize, Vec<u8>)> {
+    let mut saida = Vec::new();
+    let mut i = 0;
+    while i < texto.len() {
+        let (mut bytes, mut fim, mut j) = (Vec::new(), i, i);
+        while let Some(byte) = par_hex_em(texto, j) {
+            bytes.push(byte);
+            fim = j + 2;
+            // Entre um par e o seguinte tem que haver pelo menos um separador.
+            let k = (fim..texto.len())
+                .find(|&k| !matches!(texto[k], b' ' | b'\t' | b',' | b':' | b'\n' | b'\r'))
+                .unwrap_or(texto.len());
+            if k == fim {
+                break;
+            }
+            j = k;
+        }
+        if bytes.len() >= JANELA {
+            saida.push((i, bytes));
+        }
+        // Pula a corrida inteira. Uma corrida curta não contém outra longa, e numa longa os sufixos
+        // só repetiriam o achado, com custo quadrático.
+        i = fim.max(i + 1);
+    }
+    saida
+}
