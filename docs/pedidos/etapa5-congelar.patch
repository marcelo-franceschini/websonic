diff --color -ruN base_rel/.github/esperado-cargo-config.txt rel2/.github/esperado-cargo-config.txt
--- a/.github/esperado-cargo-config.txt	2026-11-08 03:20:55.000000000 -0300
+++ b/.github/esperado-cargo-config.txt	2026-11-08 03:21:11.141116117 -0300
@@ -5,3 +5,8 @@
 # Atalho: cargo xtask <site|anti-rom>
 [alias]
 xtask = "run --quiet --package xtask --"
+
+# Atalho: cargo fidelidade <fidelidade|manifesto|ocultos|corpus-trace>
+# O pacote fica numa pasta congelada (crates/fidelidade/relatorio), que nao aceita escrita do
+# compilador, por isso o alvo e target/relatorio. --locked: o Cargo.lock do pacote e referencia.
+fidelidade = "run --quiet --locked --manifest-path crates/fidelidade/relatorio/Cargo.toml --target-dir target/relatorio --"
