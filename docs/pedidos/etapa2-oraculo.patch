+
+/// Grava o mapa de acessos a RAM: uma linha `ENDERECO<TAB>BITS` por byte tocado, com o endereco
+/// em hexadecimal de 6 digitos (`FF0000` a `FFFFFF`) e os bits em 4 digitos hexadecimais.
+/// Bit `contexto * 3 + tipo`; contexto 0 laco principal, 1 VBlank, 2 HBlank, 3 outro; tipo 0
+/// leitura do 68000, 1 escrita do 68000, 2 leitura do DMA da VDP.
+fn escrever_acessos(arq: &str, mapa: &[u16]) -> Result<(), String> {
+    use std::io::Write;
+    let mut f = BufWriter::new(File::create(arq).map_err(|e| e.to_string())?);
+    for (i, bits) in mapa.iter().enumerate() {
+        if *bits != 0 {
+            writeln!(f, "{:06X}\t{bits:04X}", 0xFF_0000 + i).map_err(|e| e.to_string())?;
+        }
+    }
+    f.flush().map_err(|e| e.to_string())
+}
diff --color -ruN -x target -x Cargo.lock base/oracle/runner/tests/acessos.rs repo/oracle/runner/tests/acessos.rs
--- a/oracle/runner/tests/acessos.rs	1969-12-31 21:00:00.000000000 -0300
+++ b/oracle/runner/tests/acessos.rs	2026-11-06 22:37:49.689690947 -0300
@@ -0,0 +1,29 @@
+//! Mapa de acessos a RAM por contexto (pedido P2). ROM sintetica escrita por nos.
+
+use websonic_oracle::rom_sintetica::programa_vblank;
+use websonic_oracle::{Entradas, Oraculo};
+
+#[test]
+fn contador_do_vblank_fica_so_no_contexto_vblank() {
+    oracle_trace::acessos_ligar();
+    let mut oraculo = Oraculo::novo(programa_vblank(), Entradas::default()).unwrap();
+    for _ in 0..4 {
+        oraculo.executar_quadro().unwrap();
+    }
+    let mapa = oracle_trace::mapa_acessos();
+    // O contador $FF0100..$FF0103 e lido e escrito so dentro da interrupcao de VBlank.
+    // Bits: contexto 1 (VBlank) = leitura 3, escrita 4. O laco principal (bits 0 a 2) nao toca.
+    for (i, bits) in mapa[0x100..0x104].iter().enumerate() {
+        assert_eq!(bits & 0b111, 0, "o laco principal nao toca em {i:#x}");
+        assert_eq!(bits & 0b11_1000, 0b01_1000, "VBlank le e escreve {i:#x}");
+    }
+    // O quadro de excecao ($FF7FFA a $FF7FFF) e escrito no laco principal (antes de entrar na
+    // interrupcao) e lido no VBlank (pelo RTE).
+    for (i, bits) in mapa[0x7FFA..0x8000].iter().enumerate() {
+        assert_ne!(bits & 0b10, 0, "escrita no principal em {i:#x}");
+        assert_ne!(bits & 0b1000, 0, "leitura no VBlank em {i:#x}");
+    }
+    // Nada mais no mapa fora do contador e da pilha.
+    let tocados = mapa.iter().filter(|b| **b != 0).count();
+    assert_eq!(tocados, 4 + 6);
+}
diff --color -ruN -x target -x Cargo.lock base/oracle/runner/tests/gravador.rs repo/oracle/runner/tests/gravador.rs
--- a/oracle/runner/tests/gravador.rs	1969-12-31 21:00:00.000000000 -0300
+++ b/oracle/runner/tests/gravador.rs	2026-11-06 22:35:57.803629526 -0300
@@ -0,0 +1,25 @@
+//! Gravador de entradas (2.2): `WEBSONIC_GRAVAR=BASE` grava `BASE.s1in` e `BASE.ram`.
+//! Este arquivo tem um teste so, porque a variavel de ambiente vale para o processo todo.
+
+use websonic_oracle::rom_sintetica::programa_entrada;
+use websonic_oracle::{Entradas, Oraculo};
+
+#[test]
+fn grava_a_mascara_de_cada_quadro_e_a_ram_do_ultimo() {
+    let base = std::env::temp_dir().join(format!("websonic-gravador-{}", std::process::id()));
+    let base = base.to_str().unwrap().to_owned();
+    // SAFETY: o teste e o unico codigo deste processo de teste; nenhuma outra thread le o ambiente.
+    unsafe { std::env::set_var("WEBSONIC_GRAVAR", &base) };
+
+    let entradas = Entradas::nova(vec![0x00, 0x01, 0x80, 0x48, 0x00]);
+    let mut oraculo = Oraculo::novo(programa_entrada(), entradas).unwrap();
+    for _ in 0..5 {
+        oraculo.executar_quadro().unwrap();
+    }
+    let texto = std::fs::read_to_string(format!("{base}.s1in")).unwrap();
+    assert_eq!(texto, "00\n01\n80\n48\n00\n");
+    let ram = std::fs::read(format!("{base}.ram")).unwrap();
+    assert_eq!(ram, oraculo.ram68k());
+    let _ = std::fs::remove_file(format!("{base}.s1in"));
+    let _ = std::fs::remove_file(format!("{base}.ram"));
+}
