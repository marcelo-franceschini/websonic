++    use genesis_config::GenesisController;
++    let (GenesisController::ThreeButton(s) | GenesisController::SixButton(s)) = inputs.p1 else {
++        return 0;
++    };
++    [
++        (s.up, 0x01u8),
++        (s.down, 0x02),
++        (s.left, 0x04),
++        (s.right, 0x08),
++        (s.b, 0x10),
++        (s.c, 0x20),
++        (s.a, 0x40),
++        (s.start, 0x80),
++    ]
++    .into_iter()
++    .filter(|(ligado, _)| *ligado)
++    .fold(0, |m, (_, bit)| m | bit)
++}
