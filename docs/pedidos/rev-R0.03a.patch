+    /// Itens separados por `sep`, cada byte de `b` escrito por `f`.
+    fn itens(b: &[u8], sep: &str, f: impl Fn(u8) -> String) -> String {
+        b.iter().map(|&x| f(x)).collect::<Vec<_>>().join(sep)
+    }
+
+    fn hexa(x: u8) -> String {
+        format!("0x{x:02X}")
+    }
+
+    /// Palavras de 16 bits (big-endian) de `b`, escritas por `f` e separadas por vírgula.
+    fn palavras(b: &[u8], f: impl Fn(u16) -> String) -> String {
+        let partes: Vec<String> = b
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|p| f(u16::from_be_bytes(*p)))
+            .collect();
+        partes.join(", ")
+    }
+
+    /// Quartetos de 32 bits (big-endian) de `b`, escritos por `f` e separados por vírgula.
