+                "u8",
+            ),
+            (
+                "negativos em hexadecimal",
+                format!("[{}]", itens(b, ", ", |x| neg_hex(x, "0x"))),
+                "u8",
+            ),
+            (
+                "negativos com $",
+                format!("\tdc.b {}\n", itens(b, ",", |x| neg_hex(x, "$"))),
+                "u8",
+            ),
+            // O menos colado a uma letra é subtração: o primeiro valor da cópia não muda de sinal.
+            (
+                "subtração não é sinal",
+                format!("[x-{}]", itens(b, ", ", hexa)),
+                "u8",
+            ),
+            ("chaves", format!("= {{{}}};", chaves.join(", ")), "u8"),
+            (
+                "ponto e vírgula depois da vírgula",
+                format!("[{}]", itens(b, ",; ", hexa)),
+                "u8",
+            ),
+            // Um valor que não cabe em 8 bits derruba o fluxo da lista, mas não esconde a cópia.
+            (
+                "valor grande depois da cópia",
+                format!("({}), 1000", itens(b, ", ", hexa)),
+                "u8",
+            ),
+            (
+                "valor grande antes da cópia",
+                format!("[[70000], [{}]]", itens(b, ", ", hexa)),
+                "u8",
+            ),
+            (
+                "palavras coladas a valor acima de 16 bits",
+                format!("({}), 70000", palavras(b, |v| format!("0x{v:04X}"))),
+                "u16be",
+            ),
+            (
+                "32 bits colados a valor abaixo de -2^31",
+                format!(
+                    "({}), -3000000000",
+                    quartetos(&rom[2000..2064], |v| format!("0x{v:08X}"))
+                ),
+                "u32be",
+            ),
+            // Cópia escrita dentro de comentário também conta.
+            (
+                "cópia em comentário de linha",
+                format!("let t = 1; // {}\nlet u = 2;", itens(b, ", ", hexa)),
+                "u8",
+            ),
+            (
+                "cópia em comentário de bloco",
+                format!("/*\n{}\n*/", itens(b, ", ", hexa)),
+                "u8",
+            ),
+            (
+                "cópia em dois comentários de bloco",
+                format!(
+                    "/* {}, */ /* {} */",
+                    itens(&b[..20], ", ", hexa),
+                    itens(&b[20..], ", ", hexa)
+                ),
+                "u8",
+            ),
+            (
+                "// dentro de comentário de bloco",
+                format!(
+                    "/* {}, // {} */",
+                    itens(&b[..20], ", ", hexa),
+                    itens(&b[20..], ", ", hexa)
+                ),
+                "u8",
+            ),
+            ("cópia em comentários seguidos", docs, "u8"),
