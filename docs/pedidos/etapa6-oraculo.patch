++
++/// Tipos de acesso do 68000 que viram ponto do Z80.
++pub mod acesso_z80 {
++    pub const BUSREQ_PEDIDO: u8 = 0;
++    pub const BUSREQ_LIBERADO: u8 = 1;
++    pub const RESET_LIGADO: u8 = 2;
++    pub const RESET_SOLTO: u8 = 3;
++    pub const LEITURA_JANELA: u8 = 4;
++    pub const ESCRITA_JANELA: u8 = 5;
+ }
+ 
+ thread_local! {
+@@ -396,6 +417,11 @@ thread_local! {
+     static BARRAMENTO: RefCell<BTreeMap<(String, String, String), u64>> = const { RefCell::new(BTreeMap::new()) };
+     static TEMPO_LIGADO: Cell<bool> = const { Cell::new(false) };
+     static TEMPO: RefCell<Vec<TempoRaw>> = const { RefCell::new(Vec::new()) };
++    // Etapa 6: o Z80 visto no fim da ultima atualizacao (PC e ciclos que faltam da instrucao) e a
++    // contagem de ciclos do Z80 executados (nao parados por DMA), total e no ultimo ponto.
++    static Z80_VISTA: Cell<(u16, u16)> = const { Cell::new((0, 0)) };
++    static Z80_ATIVOS: Cell<u64> = const { Cell::new(0) };
++    static Z80_ATIVOS_NO_PONTO: Cell<u64> = const { Cell::new(0) };
+ }
+ 
+ pub fn instrucoes_ligar() {
+@@ -501,6 +527,47 @@ pub fn origem_e_68000() -> bool {
+     CTX.with(Cell::get).src == src::CPU68
+ }
+ 
++/// O arquivo de tempo esta ligado?
++#[must_use]
++pub fn tempo_ligado() -> bool {
++    TEMPO_LIGADO.with(Cell::get)
++}
++
++/// Conta um ciclo do Z80 executado (nao parado por DMA).
++#[inline]
++pub fn z80_ciclo_contado() {
++    Z80_ATIVOS.with(|a| a.set(a.get().wrapping_add(1)));
++}
++
++/// Guarda o PC do Z80 e os ciclos que faltam da instrucao em curso, depois de o Z80 alcançar o 68000.
++pub fn z80_vista(pc: u16, espera: u32) {
++    Z80_VISTA.with(|v| v.set((pc, u16::try_from(espera).unwrap_or(u16::MAX))));
++}
++
++/// Grava um ponto do Z80: um acesso do 68000 que toca o Z80. `endereco` e `byte` valem so nos
++/// acessos a janela. Os ciclos ativos sao contados desde o ponto anterior.
++pub fn tempo_z80_ponto(acesso: u8, banco: u32, endereco: u16, byte: u8) {
++    if TEMPO_LIGADO.with(Cell::get) {
++        let (mclk, _, _) = ctx_tempo();
++        let (pc, espera) = Z80_VISTA.with(Cell::get);
++        let total = Z80_ATIVOS.with(Cell::get);
++        let antes = Z80_ATIVOS_NO_PONTO.with(|a| a.replace(total));
++        let ativos = u32::try_from(total.wrapping_sub(antes)).unwrap_or(u32::MAX);
++        TEMPO.with(|t| {
++            t.borrow_mut().push(TempoRaw::Z80Ponto {
++                acesso,
++                pc,
++                espera,
++                ativos,
++                banco: u16::try_from(banco & 0x1FF).unwrap_or(0),
++                endereco,
++                byte,
++                mclk,
++            });
++        });
++    }
++}
++
+ /// Entrega e limpa os itens de tempo acumulados.
+ pub fn drain_tempo(saida: &mut Vec<TempoRaw>) {
+     TEMPO.with(|t| saida.append(&mut t.borrow_mut()));
+diff --git a/cpu/z80-emu/src/core.rs b/cpu/z80-emu/src/core.rs
