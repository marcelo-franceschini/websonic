{
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//mnt/rom/**)",
      "Read(//mnt/rom)",
      "Read(//mnt/disasm/**)",
      "Read(//mnt/disasm)",
      "Edit(//workspaces/websonic/docs/requisitos.md)",
      "Edit(//workspaces/websonic/.git/**)",
      "Edit(//home/dev/.claude/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git config *)",
      "Bash(git * config *)",
      "Bash(git -c *)",
      "Bash(*--no-verify*)",
      "Bash(*core.hooksPath*)",
      "Bash(sudo)",
      "Bash(sudo *)"
    ],
    "additionalDirectories": [
      "/mnt/disasm-texto",
      "/mnt/trabalho"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [],
    "network": {
      "allowManagedDomainsOnly": true,
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "platform.claude.com",
        "index.crates.io",
        "static.crates.io",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/mnt/trabalho",
        "/home/dev/.cargo"
      ],
      "denyRead": [
        "/mnt/rom",
        "/mnt/disasm"
      ],
      "denyWrite": [
        "/workspaces/websonic/docs/requisitos.md",
        "/workspaces/websonic/.git/config",
        "/workspaces/websonic/.git/hooks"
      ]
    }
  }
}
