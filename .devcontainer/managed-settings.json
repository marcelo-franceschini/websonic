{
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//mnt/rom/**)",
      "Read(//mnt/rom)",
      "Read(//mnt/disasm/**)",
      "Read(//mnt/disasm)",
      "Edit(//workspaces/websonic/docs/requisitos.md)",
      "Edit(//workspaces/websonic/CLAUDE.md)",
      "Edit(//workspaces/websonic/.gitignore)",
      "Edit(//workspaces/websonic/hooks/**)",
      "Edit(//workspaces/websonic/refs/**)",
      "Edit(//workspaces/websonic/.github/**)",
      "Edit(//workspaces/websonic/.devcontainer/**)",
      "Edit(//workspaces/websonic/.claude/**)",
      "Edit(//workspaces/websonic/.mcp.json)",
      "Edit(//workspaces/websonic/.vscode/**)",
      "Edit(//workspaces/websonic/.cargo/**)",
      "Edit(//workspaces/websonic/**/.cargo/**)",
      "Edit(//workspaces/websonic/rust-toolchain.toml)",
      "Edit(//workspaces/websonic/**/rust-toolchain)",
      "Edit(//workspaces/websonic/**/rust-toolchain.toml)",
      "Edit(//workspaces/websonic/.git/config)",
      "Edit(//workspaces/websonic/.git/hooks/**)",
      "Edit(//home/dev/.claude/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git config *)",
      "Bash(git * config *)",
      "Bash(git -c *)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(*core.hooksPath*)",
      "Bash(sudo)",
      "Bash(sudo *)"
    ],
    "additionalDirectories": [
      "/mnt/disasm-texto",
      "/mnt/trabalho"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [],
    "network": {
      "allowManagedDomainsOnly": true,
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "platform.claude.com",
        "index.crates.io",
        "static.crates.io",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/mnt/trabalho",
        "/home/dev/.cargo/registry",
        "/home/dev/.cargo/git"
      ],
      "denyRead": [
        "/mnt/rom",
        "/mnt/disasm"
      ],
      "denyWrite": [
        "/workspaces/websonic/docs/requisitos.md",
        "/workspaces/websonic/CLAUDE.md",
        "/workspaces/websonic/.gitignore",
        "/workspaces/websonic/hooks",
        "/workspaces/websonic/refs",
        "/workspaces/websonic/.github",
        "/workspaces/websonic/.devcontainer",
        "/workspaces/websonic/.claude",
        "/workspaces/websonic/.mcp.json",
        "/workspaces/websonic/.vscode",
        "/workspaces/websonic/.cargo",
        "/workspaces/websonic/rust-toolchain.toml",
        "/workspaces/websonic/.git/config",
        "/workspaces/websonic/.git/hooks"
      ]
    }
  }
}
