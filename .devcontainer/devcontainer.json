{
  "name": "websonic-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/websonic",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/websonic,type=bind",
  "initializeCommand": "sh .devcontainer/verifica-host.sh",
  "mounts": [
    "source=${localEnv:SONIC1_EXT_DIR}/rom,target=/mnt/rom,type=bind,readonly",
    "source=${localEnv:SONIC1_EXT_DIR}/disasm,target=/mnt/disasm,type=bind,readonly",
    "source=${localEnv:SONIC1_EXT_DIR}/disasm-texto,target=/mnt/disasm-texto,type=bind,readonly",
    "source=${localEnv:SONIC1_EXT_DIR}/trabalho,target=/mnt/trabalho,type=bind",
    "source=websonic-claude-config,target=/home/dev/.claude,type=volume"
  ],
  "containerUser": "dev",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "securityOpt": [
    "seccomp=${localWorkspaceFolder}/.devcontainer/seccomp-userns.json"
  ],
  "capAdd": [
    "NET_ADMIN",
    "NET_RAW"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "GIT_AUTHOR_NAME": "Claude Code",
    "GIT_AUTHOR_EMAIL": "claude-code@local",
    "GIT_COMMITTER_NAME": "Claude Code",
    "GIT_COMMITTER_EMAIL": "claude-code@local",
    "SSH_AUTH_SOCK": "",
    "GIT_ASKPASS": "",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_CONFIG_PARAMETERS": "'credential.helper='"
  },
  "remoteEnv": {
    "VSCODE_IPC_HOOK_CLI": "",
    "VSCODE_GIT_IPC_HANDLE": "",
    "GIT_ASKPASS": "",
    "SSH_AUTH_SOCK": ""
  },
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
