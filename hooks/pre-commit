#!/bin/sh
# Antes do commit: bloqueia commits diretos na main e bloqueia ROM por extensao, tamanho e hash (ver hooks/lib.sh).
. "$(dirname "$0")/lib.sh"

# Bloqueia commits diretos na branch main no repositorio oficial.
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ]; then
    remoto=$(git config --get remote.origin.url 2>/dev/null || echo "")
    case "$remoto" in
        *marcelo-franceschini/websonic*)
            printf 'ERRO: Commits diretos na branch "main" estão bloqueados.\nCrie uma nova branch (ex: git checkout -b feature/...) e abra um Pull Request.\n' >&2
            exit 1
            ;;
    esac
fi

tab=$(printf '\t')

# Lista o que foi adicionado, modificado ou trocado de tipo no indice.
# Linha: ":modo_antigo modo_novo id_antigo id_novo status<TAB>caminho".
problemas=$(
    git diff --cached --raw --no-abbrev --no-renames --diff-filter=AMT |
    while IFS="$tab" read -r meta caminho; do
        set -- $meta
        [ "$2" = 160000 ] && continue   # submodulo: nao tem conteudo proprio
        printf '%s %s\n' "$4" "$caminho"
    done | verificar_objetos
)

[ -z "$problemas" ] || recusar "commit" "$problemas"
exit 0
