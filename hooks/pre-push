#!/bin/sh
# Antes do push: bloqueia push direto na main e repete a verificacao em TUDO o que seria enviado.
# Cobre o historico: um arquivo apagado num commit posterior continua no historico.
# Esta e a barreira contra --no-verify, porque roda no push do Marcelo.
. "$(dirname "$0")/lib.sh"

zero=0000000000000000000000000000000000000000

# Entrada do git: "<ref local> <id local> <ref remota> <id remoto>" por linha.
linhas=$(cat)

# Primeira passagem: confere se ha tentativa de push direto na main do repositorio oficial.
remoto=$(git config --get remote.origin.url 2>/dev/null || echo "")
case "$remoto" in
    *marcelo-franceschini/websonic*)
        bloqueado=$(
            echo "$linhas" | while read -r ref_local id_local ref_remota id_remoto; do
                if [ "$ref_remota" = "refs/heads/main" ] && [ "$id_local" != "$zero" ]; then
                    echo "sim"
                    break
                fi
            done
        )
        if [ "$bloqueado" = "sim" ]; then
            printf 'ERRO: Push direto para a branch "main" está bloqueado.\nEnvie suas alterações em uma branch de funcionalidade e abra um Pull Request.\n' >&2
            exit 1
        fi
        ;;
esac

problemas=$(
    echo "$linhas" | while read -r ref_local id_local ref_remota id_remoto; do
        [ "$id_local" = "$zero" ] && continue   # apagar branch nao envia objetos
        # Objetos alcancaveis do que sobe e ainda nao estao em nenhuma ref remota.
        git rev-list --objects "$id_local" --not --remotes
    done | verificar_objetos
)

[ -z "$problemas" ] || recusar "push" "$problemas"
exit 0
