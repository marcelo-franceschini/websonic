+/// Nome fixo da região do barramento do 68000 para o inventário de acessos (Etapa 5).
+fn oraculo_regiao(address: u32, busack: bool) -> &'static str {
+    match address {
+        0x000000..=0x3FFFFF => "rom",
+        0xA00000..=0xA0FFFF if busack => "z80_janela",
+        0xA00000..=0xA0FFFF => "z80_janela_sem_busack",
+        0xA10000..=0xA1001F => "io",
+        0xA11100..=0xA111FF => "z80_barramento",
+        0xA11200..=0xA112FF => "z80_reset",
+        0xA14000..=0xA14003 => "tmss",
+        0xC00000..=0xC0001F => "vdp",
+        0xE00000..=0xFFFFFF => "ram",
+        _ => "sem_dispositivo",
+    }
+}
diff --git a/common/oracle-trace/src/lib.rs b/common/oracle-trace/src/lib.rs
index 59db457f..bd3de240 100644
--- a/common/oracle-trace/src/lib.rs
+++ b/common/oracle-trace/src/lib.rs
@@ -366,3 +366,142 @@ pub fn gravador_fim_quadro(ram: &[u8]) {
         }
     });
 }
+
+// ---------------------------------------------------------------------------------------------
+// Inventários de instruções e de barramento, e o arquivo de tempo (Etapa 5, patch 0004).
+// Só contagens, nomes de classe e endereços. Nenhum valor de memória.
+// ---------------------------------------------------------------------------------------------
+
+use std::collections::BTreeMap;
+
+/// Classe de leitura de hardware gravada no arquivo de tempo.
+pub mod leitura {
+    pub const BUSACK: u8 = 0;
+    pub const VDP_STATUS: u8 = 1;
+    pub const YM_STATUS: u8 = 2;
+}
+
+/// Um item do arquivo de tempo, na ordem em que aconteceu dentro do quadro.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TempoRaw {
+    Interrupcao { nivel: u8, pc_interrompido: u32, pc_tratador: u32, mclk: u64, linha: u16, coluna: u16 },
+    Leitura { classe: u8, valor: u16, mclk: u64 },
+    EsperaZ80 { ciclos: u32, mclk: u64 },
+}
+
+thread_local! {
+    static INSTRUCOES_LIGADO: Cell<bool> = const { Cell::new(false) };
+    static INSTRUCOES: RefCell<BTreeMap<(String, String), u64>> = const { RefCell::new(BTreeMap::new()) };
+    static BARRAMENTO_LIGADO: Cell<bool> = const { Cell::new(false) };
+    static BARRAMENTO: RefCell<BTreeMap<(String, String, String), u64>> = const { RefCell::new(BTreeMap::new()) };
+    static TEMPO_LIGADO: Cell<bool> = const { Cell::new(false) };
+    static TEMPO: RefCell<Vec<TempoRaw>> = const { RefCell::new(Vec::new()) };
+}
+
+pub fn instrucoes_ligar() {
+    INSTRUCOES_LIGADO.with(|a| a.set(true));
+}
+
+#[inline]
+pub fn instrucoes_ligadas() -> bool {
+    INSTRUCOES_LIGADO.with(Cell::get)
+}
+
+/// Conta uma instrução decodificada. Guarda só o nome da variante e o tamanho, tirados do
+/// texto de depuração (o resto, como operandos, é descartado).
+pub fn instrucao_debug<T: std::fmt::Debug>(instrucao: &T) {
+    let texto = format!("{instrucao:?}");
+    let nome: String = texto.chars().take_while(|c| c.is_ascii_alphanumeric()).collect();
+    let tamanho = texto
+        .split("size: ")
+        .nth(1)
+        .map(|r| r.chars().take_while(|c| c.is_ascii_alphanumeric()).collect::<String>())
+        .unwrap_or_else(|| "-".to_string());
+    INSTRUCOES.with(|m| *m.borrow_mut().entry((nome, tamanho)).or_insert(0) += 1);
+}
+
+#[must_use]
+pub fn mapa_instrucoes() -> Vec<(String, String, u64)> {
+    INSTRUCOES.with(|m| m.borrow().iter().map(|((n, t), c)| (n.clone(), t.clone(), *c)).collect())
+}
+
+pub fn barramento_ligar() {
+    BARRAMENTO_LIGADO.with(|a| a.set(true));
+}
+
+/// Conta um acesso do 68000 (`op` = "leitura", "escrita" ou "dma"). `regiao` é um nome fixo.
+#[inline]
+pub fn barramento(regiao: &str, op: &str, bytes: u32) {
+    if BARRAMENTO_LIGADO.with(Cell::get) {
+        BARRAMENTO.with(|m| {
+            *m.borrow_mut().entry((regiao.to_string(), op.to_string(), bytes.to_string())).or_insert(0) += 1;
+        });
+    }
+}
+
+/// Conta uma exceção do 68000 pelo número do vetor.
+pub fn excecao(vetor: u32) {
+    if BARRAMENTO_LIGADO.with(Cell::get) {
+        BARRAMENTO.with(|m| {
+            *m.borrow_mut().entry(("excecao".to_string(), "vetor".to_string(), vetor.to_string())).or_insert(0) += 1;
+        });
+    }
+}
+
+#[must_use]
+pub fn mapa_barramento() -> Vec<(String, String, String, u64)> {
+    BARRAMENTO.with(|m| m.borrow().iter().map(|((r, o, t), c)| (r.clone(), o.clone(), t.clone(), *c)).collect())
+}
+
+pub fn tempo_ligar() {
+    TEMPO_LIGADO.with(|a| a.set(true));
+}
+
+fn ctx_tempo() -> (u64, u16, u16) {
+    let c = CTX.with(Cell::get);
+    (c.mclk, c.line, c.col)
+}
+
+/// Interrupção tomada pelo 68000.
+pub fn tempo_interrupcao(nivel: u32, pc_interrompido: u32, pc_tratador: u32) {
+    if TEMPO_LIGADO.with(Cell::get) {
+        let (mclk, linha, coluna) = ctx_tempo();
+        TEMPO.with(|t| {
+            t.borrow_mut().push(TempoRaw::Interrupcao {
+                nivel: u8::try_from(nivel).unwrap_or(0),
+                pc_interrompido,
+                pc_tratador,
+                mclk,
+                linha,
+                coluna,
+            });
+        });
+    }
+}
+
+/// Leitura de estado de hardware feita pelo 68000. `valor` é o que o 68000 leu.
+pub fn tempo_leitura(classe: u8, valor: u16) {
+    if TEMPO_LIGADO.with(Cell::get) {
+        let (mclk, _, _) = ctx_tempo();
+        TEMPO.with(|t| t.borrow_mut().push(TempoRaw::Leitura { classe, valor, mclk }));
+    }
+}
+
+/// Espera do 68000 consumida (por exemplo, por acesso do Z80).
+pub fn tempo_espera(ciclos: u32) {
+    if TEMPO_LIGADO.with(Cell::get) {
+        let (mclk, _, _) = ctx_tempo();
+        TEMPO.with(|t| t.borrow_mut().push(TempoRaw::EsperaZ80 { ciclos, mclk }));
+    }
+}
+
+/// A origem do contexto atual é o 68000?
+#[must_use]
+pub fn origem_e_68000() -> bool {
+    CTX.with(Cell::get).src == src::CPU68
+}
+
+/// Entrega e limpa os itens de tempo acumulados.
+pub fn drain_tempo(saida: &mut Vec<TempoRaw>) {
+    TEMPO.with(|t| saida.append(&mut t.borrow_mut()));
+}
