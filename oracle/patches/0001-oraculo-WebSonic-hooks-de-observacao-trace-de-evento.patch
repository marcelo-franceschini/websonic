diff --git a/backend/genesis-core/src/api/oracle.rs b/backend/genesis-core/src/api/oracle.rs
new file mode 100644
index 00000000..0f036f4a
--- /dev/null
+++ b/backend/genesis-core/src/api/oracle.rs
@@ -0,0 +1,102 @@
+//! Acessores de leitura e escrita do oraculo WebSonic (GPLv3, como o jgenesis).
+//!
+//! Estes metodos ficam aqui porque os campos de `GenesisEmulator` sao privados. Eles nao mudam a
+//! emulacao: leem estado, e as escritas so servem para montar o estado inicial de um teste.
+
+use super::GenesisEmulator;
+use bincode::{Decode, Encode};
+
+/// Registradores do 68000 para ler e escrever.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Encode, Decode)]
+pub struct Regs68 {
+    pub d: [u32; 8],
+    pub a: [u32; 7],
+    pub usp: u32,
+    pub ssp: u32,
+    pub sr: u16,
+    pub pc: u32,
+}
+
+impl GenesisEmulator {
+    /// Endereco da proxima instrucao do 68000.
+    #[must_use]
+    pub fn oracle_pc68(&self) -> u32 {
+        self.m68k.pc()
+    }
+
+    /// Endereco da proxima instrucao do Z80.
+    #[must_use]
+    pub fn oracle_pc80(&self) -> u16 {
+        self.z80.pc()
+    }
+
+    /// Relogio mestre desde o ligar, no inicio da proxima instrucao do 68000.
+    #[must_use]
+    pub fn oracle_mclk(&self) -> u64 {
+        self.bus.cycles.m68k_mclk_cycles
+    }
+
+    /// Linha da VDP e ciclos mestres desde o inicio da linha.
+    #[must_use]
+    pub fn oracle_posicao_vdp(&self) -> (u16, u64) {
+        (self.bus.vdp.scanline(), self.bus.vdp.scanline_mclk())
+    }
+
+    #[must_use]
+    pub fn oracle_regs68(&self) -> Regs68 {
+        Regs68 {
+            d: self.m68k.data_registers(),
+            a: self.m68k.address_registers(),
+            usp: self.m68k.user_stack_pointer(),
+            ssp: self.m68k.supervisor_stack_pointer(),
+            sr: self.m68k.status_register(),
+            pc: self.m68k.pc(),
+        }
+    }
+
+    /// Define os registradores do 68000 e recarrega o prefetch no PC dado.
+    pub fn oracle_definir_regs68(&mut self, regs: &Regs68) {
+        self.m68k.set_data_registers(regs.d);
+        self.m68k.set_address_registers(regs.a, regs.usp, regs.ssp);
+        self.m68k.set_status_register(regs.sr);
+        self.m68k.set_pc(regs.pc, &mut self.bus);
+    }
+
+    #[must_use]
+    pub fn oracle_ram68k_byte(&self, endereco: u32) -> u8 {
+        self.bus.memory.read_main_ram_byte(endereco)
+    }
+
+    pub fn oracle_escrever_ram68k_byte(&mut self, endereco: u32, valor: u8) {
+        self.bus.memory.write_main_ram::<false>(endereco, valor.into());
+    }
+
+    #[must_use]
+    pub fn oracle_ram_z80_byte(&self, endereco: u16) -> u8 {
+        self.bus.memory.read_audio_ram(endereco)
+    }
+
+    pub fn oracle_escrever_ram_z80_byte(&mut self, endereco: u16, valor: u8) {
+        self.bus.memory.write_audio_ram(endereco, valor);
+    }
+
+    #[must_use]
+    pub fn oracle_vram(&self) -> &[u8] {
+        self.bus.vdp.oracle_vram()
+    }
+
+    #[must_use]
+    pub fn oracle_cram(&self) -> &[u16] {
+        self.bus.vdp.oracle_cram()
+    }
+
+    #[must_use]
+    pub fn oracle_vsram(&self) -> &[u16] {
+        self.bus.vdp.oracle_vsram()
+    }
+
+    #[must_use]
+    pub fn oracle_registradores_vdp(&self) -> String {
+        self.bus.vdp.oracle_registradores()
+    }
+}
