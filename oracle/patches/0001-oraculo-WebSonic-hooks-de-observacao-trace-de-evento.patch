diff --git a/common/oracle-trace/src/lib.rs b/common/oracle-trace/src/lib.rs
new file mode 100644
index 00000000..2bc1ba5d
--- /dev/null
+++ b/common/oracle-trace/src/lib.rs
@@ -0,0 +1,191 @@
+//! Hooks de observacao do oraculo WebSonic (GPLv3, como o jgenesis).
+//!
+//! Este crate so observa. Nenhuma funcao daqui muda o estado da emulacao.
+//! Quando o registro esta desligado, cada hook custa uma leitura de `Cell<bool>`.
+//!
+//! O estado fica em `thread_local`, porque o oraculo roda em uma thread so. Os eventos nao fazem
+//! parte do savestate.
+
+use std::cell::{Cell, RefCell};
+
+/// Tipos de evento. Os numeros espelham `sonic1_fidelidade::Tipo`.
+pub mod kind {
+    pub const INT68: u8 = 1;
+    pub const DESVIO68: u8 = 2;
+    pub const INT80: u8 = 3;
+    pub const DESVIO80: u8 = 4;
+    pub const VDP: u8 = 5;
+    pub const YM: u8 = 6;
+    pub const PSG: u8 = 7;
+    pub const BARRAMENTO_Z80: u8 = 8;
+    pub const ESPERA_ACUMULADA: u8 = 9;
+    pub const ESPERA_CONSUMIDA: u8 = 10;
+    pub const LEITURA_BUSACK: u8 = 11;
+}
+
+/// Origem do evento. Os numeros espelham `sonic1_fidelidade::Origem`.
+pub mod src {
+    pub const CPU68: u8 = 0;
+    pub const Z80: u8 = 1;
+    pub const HARDWARE: u8 = 2;
+}
+
+/// Classes de desvio do 68000.
+pub mod classe68 {
+    pub const BRA: u32 = 1;
+    pub const BCC: u32 = 2;
+    pub const BSR: u32 = 3;
+    pub const DBCC: u32 = 4;
+    pub const JMP: u32 = 5;
+    pub const JSR: u32 = 6;
+    pub const RTS: u32 = 7;
+    pub const RTR: u32 = 8;
+    pub const RTE: u32 = 9;
+    pub const EXCECAO: u32 = 10;
+}
+
+/// Classes de desvio do Z80.
+pub mod classe80 {
+    pub const JR: u32 = 1;
+    pub const JR_CC: u32 = 2;
+    pub const DJNZ: u32 = 3;
+    pub const JP: u32 = 4;
+    pub const JP_CC: u32 = 5;
+    pub const JP_HL: u32 = 6;
+    pub const CALL: u32 = 7;
+    pub const CALL_CC: u32 = 8;
+    pub const RET: u32 = 9;
+    pub const RET_CC: u32 = 10;
+    pub const RETI: u32 = 11;
+    pub const RST: u32 = 12;
+}
+
+/// Evento bruto, ainda sem numero de sequencia.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Raw {
+    pub mclk: u64,
+    pub kind: u8,
+    pub src: u8,
+    pub line: u16,
+    pub col: u16,
+    pub a: u32,
+    pub b: u32,
+    pub c: u32,
+    pub d: u32,
+}
+
+#[derive(Clone, Copy, Default)]
+struct Ctx {
+    mclk: u64,
+    src: u8,
+    line: u16,
+    col: u16,
+    pc68: u32,
+    pc80: u32,
+}
+
+thread_local! {
+    static ENABLED: Cell<bool> = const { Cell::new(false) };
+    static CTX: Cell<Ctx> = const { Cell::new(Ctx { mclk: 0, src: 0, line: 0, col: 0, pc68: 0, pc80: 0 }) };
+    static BUF: RefCell<Vec<Raw>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Liga ou desliga o registro.
+pub fn set_enabled(on: bool) {
+    ENABLED.with(|e| e.set(on));
+}
+
+#[inline]
+pub fn enabled() -> bool {
+    ENABLED.with(Cell::get)
+}
+
+/// Define o contexto de tempo e de origem dos proximos eventos.
+#[inline]
+pub fn set_ctx(mclk: u64, src: u8, line: u16, col: u16) {
+    if enabled() {
+        CTX.with(|c| {
+            let mut ctx = c.get();
+            ctx.mclk = mclk;
+            ctx.src = src;
+            ctx.line = line;
+            ctx.col = col;
+            c.set(ctx);
+        });
+    }
+}
+
+/// Endereco da instrucao do 68000 em execucao.
+#[inline]
+pub fn set_pc68(pc: u32) {
+    if enabled() {
+        CTX.with(|c| {
+            let mut ctx = c.get();
+            ctx.pc68 = pc;
+            c.set(ctx);
+        });
+    }
+}
+
+/// Endereco da instrucao do Z80 em execucao.
+#[inline]
+pub fn set_pc80(pc: u16) {
+    if enabled() {
+        CTX.with(|c| {
+            let mut ctx = c.get();
+            ctx.pc80 = pc.into();
+            c.set(ctx);
+        });
+    }
+}
+
+#[inline]
+fn push(raw: Raw) {
+    BUF.with(|b| b.borrow_mut().push(raw));
+}
+
+/// Registra um evento no contexto atual.
+#[inline]
+pub fn emit(kind: u8, a: u32, b: u32, c: u32, d: u32) {
+    if enabled() {
+        let ctx = CTX.with(Cell::get);
+        push(Raw { mclk: ctx.mclk, kind, src: ctx.src, line: ctx.line, col: ctx.col, a, b, c, d });
+    }
+}
+
+/// Registra um evento com a posicao da VDP dada (linha e coluna no momento da aplicacao).
+#[inline]
+pub fn emit_at(kind: u8, line: u16, col: u16, a: u32, b: u32, c: u32, d: u32) {
+    if enabled() {
+        let ctx = CTX.with(Cell::get);
+        push(Raw { mclk: ctx.mclk, kind, src: ctx.src, line, col, a, b, c, d });
+    }
+}
+
+/// Desvio do 68000. `destino` so vale se `tomado`.
+#[inline]
+pub fn desvio68(classe: u32, destino: u32, tomado: bool) {
+    if enabled() {
+        let pc = CTX.with(|c| c.get().pc68);
+        emit(kind::DESVIO68, pc, if tomado { destino } else { 0 }, classe, u32::from(tomado));
+    }
+}
+
+/// Desvio do Z80. `destino` so vale se `tomado`.
+#[inline]
+pub fn desvio80(classe: u32, destino: u32, tomado: bool) {
+    if enabled() {
+        let pc = CTX.with(|c| c.get().pc80);
+        emit(kind::DESVIO80, pc, if tomado { destino } else { 0 }, classe, u32::from(tomado));
+    }
+}
+
+/// Move os eventos acumulados para `saida`, na ordem em que ocorreram.
+pub fn drain(saida: &mut Vec<Raw>) {
+    BUF.with(|b| saida.append(&mut b.borrow_mut()));
+}
+
+/// Descarta os eventos acumulados.
+pub fn clear() {
+    BUF.with(|b| b.borrow_mut().clear());
+}
