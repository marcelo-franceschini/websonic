+/// Mascara de botoes do controle 1 no formato do corpus (Cima 01, Baixo 02, Esquerda 04,
+/// Direita 08, B 10, C 20, A 40, Start 80).
+#[must_use]
+pub fn oracle_mascara_p1(inputs: &genesis_config::GenesisInputs) -> u8 {
+    use genesis_config::GenesisController;
+    let (GenesisController::ThreeButton(s) | GenesisController::SixButton(s)) = inputs.p1 else {
+        return 0;
+    };
+    [
+        (s.up, 0x01u8),
+        (s.down, 0x02),
+        (s.left, 0x04),
+        (s.right, 0x08),
+        (s.b, 0x10),
+        (s.c, 0x20),
+        (s.a, 0x40),
+        (s.start, 0x80),
+    ]
+    .into_iter()
+    .filter(|(ligado, _)| *ligado)
+    .fold(0, |m, (_, bit)| m | bit)
+}
+
+impl GenesisEmulator {
+    /// Passo do gravador de entradas (2.2). Devolve se o gravador esta ligado.
+    pub(super) fn oracle_gravador_passo(&self, inputs: &genesis_config::GenesisInputs) -> bool {
+        oracle_trace::gravador_passo(oracle_mascara_p1(inputs))
+    }
+
+    /// Fim de quadro do gravador: entrega a RAM do 68000 inteira.
+    pub(super) fn oracle_gravador_fim_quadro(&self) {
+        let ram: Vec<u8> = (0..=0xFFFFu32).map(|e| self.oracle_ram68k_byte(0xFF_0000 + e)).collect();
+        oracle_trace::gravador_fim_quadro(&ram);
+    }
+}
