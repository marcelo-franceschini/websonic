+
+// ---------------------------------------------------------------------------------------------
+// Mapa de acessos a RAM do 68000 por contexto (pedido P2) e gravador de entradas (2.2).
+// ---------------------------------------------------------------------------------------------
+
+/// Contexto de execucao do 68000, deduzido das excecoes tomadas e dos RTE.
+pub mod ctx {
+    /// Laco principal (nenhuma interrupcao em andamento).
+    pub const PRINCIPAL: u8 = 0;
+    /// Interrupcao de nivel 6 (VBlank).
+    pub const VBLANK: u8 = 1;
+    /// Interrupcao de nivel 4 (HBlank).
+    pub const HBLANK: u8 = 2;
+    /// Qualquer outro nivel.
+    pub const OUTRO: u8 = 3;
+}
+
+/// Tipo de acesso a RAM.
+pub mod acesso {
+    pub const LEITURA: u8 = 0;
+    pub const ESCRITA: u8 = 1;
+    /// Leitura feita pelo DMA da VDP (nao pelo 68000).
+    pub const DMA: u8 = 2;
+}
+
+thread_local! {
+    static ACESSOS_LIGADO: Cell<bool> = const { Cell::new(false) };
+    static PILHA_CTX: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
+    /// 65536 entradas (um por byte da RAM). Bit `ctx * 3 + tipo`.
+    static MAPA_RAM: RefCell<Vec<u16>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Liga o mapa de acessos (zera o mapa e a pilha de contextos).
+pub fn acessos_ligar() {
+    MAPA_RAM.with(|m| *m.borrow_mut() = vec![0; 0x1_0000]);
+    PILHA_CTX.with(|p| p.borrow_mut().clear());
+    ACESSOS_LIGADO.with(|a| a.set(true));
+}
+
+/// Contexto atual (o topo da pilha, ou o laco principal).
+#[must_use]
+pub fn ctx_atual() -> u8 {
+    PILHA_CTX.with(|p| p.borrow().last().copied().unwrap_or(ctx::PRINCIPAL))
+}
+
+/// Empilha o contexto de uma interrupcao tomada.
+fn ctx_entrar(nivel: u32) {
+    let c = match nivel {
+        6 => ctx::VBLANK,
+        4 => ctx::HBLANK,
+        _ => ctx::OUTRO,
+    };
+    PILHA_CTX.with(|p| p.borrow_mut().push(c));
+}
+
+/// Desempilha no RTE (uma pilha vazia fica vazia: o RTE de uma excecao nao contada).
+fn ctx_sair() {
+    PILHA_CTX.with(|p| {
+        p.borrow_mut().pop();
+    });
+}
+
+/// Marca o acesso a `bytes` bytes da RAM a partir de `endereco` (so os 16 bits baixos valem).
+#[inline]
+pub fn acesso_ram(endereco: u32, bytes: u32, tipo: u8) {
+    if ACESSOS_LIGADO.with(Cell::get) {
+        let bit = 1u16 << (u32::from(ctx_atual()) * 3 + u32::from(tipo));
+        MAPA_RAM.with(|m| {
+            let mut m = m.borrow_mut();
+            for i in 0..bytes {
+                let idx = (endereco.wrapping_add(i) & 0xFFFF) as usize;
+                m[idx] |= bit;
+            }
+        });
+    }
+}
+
+/// Copia do mapa de acessos (vazio se nunca foi ligado).
+#[must_use]
+pub fn mapa_acessos() -> Vec<u16> {
+    MAPA_RAM.with(|m| m.borrow().clone())
+}
+
+/// Gravador de entradas: grava um byte (mascara de botoes) por quadro.
+struct Gravador {
+    mascara: File,
+    ram: String,
+    primeira: Option<u8>,
+    mudancas: u32,
+    quadros: u32,
+}
+
+thread_local! {
+    static GRAVADOR: RefCell<Option<Gravador>> = const { RefCell::new(None) };
+    static GRAVADOR_INICIADO: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Le `WEBSONIC_GRAVAR=BASE` uma vez por thread. Cria `BASE.s1in` e, a cada quadro, sobrescreve
+/// `BASE.ram` com a RAM do 68000 do quadro que acabou de fechar.
+fn gravador_iniciar() {
+    if GRAVADOR_INICIADO.with(Cell::get) {
+        return;
+    }
+    GRAVADOR_INICIADO.with(|g| g.set(true));
+    let Ok(base) = std::env::var("WEBSONIC_GRAVAR") else { return };
+    let Ok(mascara) = File::create(format!("{base}.s1in")) else {
+        eprintln!("WEBSONIC_GRAVAR: nao consegui criar {base}.s1in");
+        return;
+    };
+    eprintln!("WEBSONIC_GRAVAR: gravando em {base}.s1in e {base}.ram");
+    GRAVADOR.with(|g| {
+        *g.borrow_mut() =
+            Some(Gravador { mascara, ram: format!("{base}.ram"), primeira: None, mudancas: 0, quadros: 0 });
+    });
+}
+
+/// Chamado a cada passo do emulador, com a mascara de botoes lida agora. Devolve se o gravador
+/// esta ligado (para o chamador so montar a RAM no fim do quadro quando precisar).
+pub fn gravador_passo(mascara: u8) -> bool {
+    gravador_iniciar();
+    GRAVADOR.with(|g| {
+        let mut g = g.borrow_mut();
+        let Some(g) = g.as_mut() else { return false };
+        match g.primeira {
+            None => g.primeira = Some(mascara),
+            Some(p) if p != mascara => g.mudancas += 1,
+            Some(_) => {}
+        }
+        true
+    })
+}
+
+/// Fecha o quadro: grava a mascara do inicio dele e a RAM do 68000 (`ram` tem 65536 bytes).
+pub fn gravador_fim_quadro(ram: &[u8]) {
+    use std::io::Write;
+    GRAVADOR.with(|g| {
+        let mut g = g.borrow_mut();
+        let Some(g) = g.as_mut() else { return };
+        let m = g.primeira.take().unwrap_or(0);
+        let _ = writeln!(g.mascara, "{m:02X}");
+        let _ = g.mascara.flush();
+        g.quadros += 1;
+        let _ = std::fs::write(&g.ram, ram);
+        if g.mudancas > 0 && g.quadros % 600 == 0 {
+            eprintln!(
+                "WEBSONIC_GRAVAR: {} quadros; a mascara mudou {} vezes dentro de um quadro",
+                g.quadros, g.mudancas
+            );
+        }
+    });
+}
