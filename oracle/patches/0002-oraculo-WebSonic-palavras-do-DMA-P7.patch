+
+/// Registra uma palavra lida pelo DMA de memoria para VDP, na ordem de leitura (pedido P7).
+#[inline]
+pub fn dma_word(palavra: u16) {
+    if enabled() {
+        DMA.with(|d| d.borrow_mut().push(palavra));
+    }
+}
+
+/// Entrega e esvazia as palavras de DMA acumuladas.
+pub fn take_dma() -> Vec<u16> {
+    DMA.with(|d| std::mem::take(&mut *d.borrow_mut()))
+}
+
+/// Descarta as palavras de DMA acumuladas.
+pub fn clear_dma() {
+    DMA.with(|d| d.borrow_mut().clear());
+}
